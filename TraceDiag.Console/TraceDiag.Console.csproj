<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net48;net10.0</TargetFrameworks>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>TraceDiag.Console</AssemblyName>
    <RootNamespace>TraceDiag.Console</RootNamespace>
    <Version>1.9.9</Version>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net48'">
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\TraceDiag.Core\TraceDiag.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>TraceDiag.Console.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <None Include="..\localizations\*.json" Link="localizations\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\dns-servers.json" Link="dns-servers.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
