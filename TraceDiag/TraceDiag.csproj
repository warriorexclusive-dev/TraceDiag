<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>TraceDiag</AssemblyName>
    <RootNamespace>TraceDiag</RootNamespace>
    <Version>1.9.6</Version>
    <ApplicationIcon>Resources\cable_24dp.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\TraceDiag.Core\TraceDiag.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>TraceDiag.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\cable_24dp.ico" LogicalName="TraceDiag.Resources.cable_24dp.ico" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\localizations\*.json" Link="localizations\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\dns-servers.json" Link="dns-servers.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
